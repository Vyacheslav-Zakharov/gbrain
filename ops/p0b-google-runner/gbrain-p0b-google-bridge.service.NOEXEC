# UNFINALIZED NOEXEC TEMPLATE — DO NOT INSTALL OR ENABLE.
[Unit]
Description=GBrain P0-B bounded Google g768 reconciler (NOEXEC template)
ConditionPathIsReadWrite=/var/lib/gbrain
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=1

[Service]
Type=oneshot
ExecCondition=/usr/bin/false
DynamicUser=yes
User=
Group=
UMask=0077
LoadCredential=google-generative-ai-api-key
ExecStart=/usr/lib/gbrain/p0b-google-runner --request /usr/lib/gbrain/p0b-google-package/run-request.json
Environment=
WorkingDirectory=/var/lib/gbrain
StateDirectory=gbrain-p0b-google
RuntimeDirectory=gbrain-p0b-google
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/usr/lib/gbrain/p0b-google-package
ReadWritePaths=/var/lib/gbrain
RuntimeMaxSec=300
TimeoutStartSec=310
TimeoutStopSec=15
Restart=no
KillMode=control-group
SendSIGKILL=yes
LimitNPROC=32
TasksMax=32
MemoryHigh=512M
MemoryMax=768M
CPUQuota=100%
StandardOutput=journal
StandardError=journal

# Intentionally no installation section: activation remains blocked.

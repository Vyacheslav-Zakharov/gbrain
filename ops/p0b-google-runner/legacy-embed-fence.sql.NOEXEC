-- UNFINALIZED NOEXEC DESIGN — DO NOT APPLY.
-- This lineage deliberately contains no trigger/function DDL because the reviewed
-- GUC-based writer identity was spoofable and snapshot-only lifecycle checks were
-- not race-safe. Any attempt to execute this file fails before touching catalogs.
DO $p0b_noexec$
BEGIN
  RAISE EXCEPTION 'P0B_LEGACY_FENCE_UNFINALIZED_NOEXEC'
    USING ERRCODE = '42501';
END
$p0b_noexec$;

